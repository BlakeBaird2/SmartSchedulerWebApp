# Firebase, for signing in and syncing a setup between devices (optional).
# Without these the app works as before, from the browser alone.
# Copy to .env.local for local development, and add the same four to Vercel
# (Project → Settings → Environment Variables), then redeploy.
# Values come from Firebase console → Project settings → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Development only: use Firebase's local emulators (firebase emulators:start --only auth,firestore).
# NEXT_PUBLIC_FIREBASE_EMULATOR=true
